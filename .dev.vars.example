# 이 파일을 `.dev.vars`로 복사해서 값을 채운다. 복사본은 git에 올라가지 않는다.
#   cp .dev.vars.example .dev.vars
#
# 배포용은 이 파일과 무관하다 — `wrangler secret put <이름>`으로 따로 넣는다.
# 값을 어디서 얻는지는 README의 배포 절에 적혀 있다.

BETTER_AUTH_SECRET=""   # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# https://console.cloud.google.com/apis/credentials 에서 만든 값
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
